{
  "manifest_version": 3,
  "name": "Mochi · Guardar apunte",
  "short_name": "Mochi",
  "version": "1.0.0",
  "description": "Guardá tus pizarras de Excalidraw y cualquier archivo directo en tus materias de Mochi.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guardar en Mochi",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "identity", "storage"],
  "host_permissions": ["https://excalidraw.com/*", "https://mochi-facu.vercel.app/*", "https://www.googleapis.com/*"]
}
