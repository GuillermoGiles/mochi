# Copiá este archivo como .env.local y completalo (ver docs/CONFIGURACION.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cualquier texto largo y aleatorio. Sirve para cifrar la sesión.
SESSION_SECRET=
# Clave de API de Google (restringida a Drive API y a este sitio). Sirve para recibir apuntes compartidos.
VITE_GOOGLE_API_KEY=
# Avisos de parciales y entregas (ver docs/CONFIGURACION.md). Opcional en la compu.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
